DATABASE_URL=postgresql://localhost:5432/agentsim

# LLM_PROVIDER: anthropic | groq
LLM_PROVIDER=anthropic

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# EMBEDDING_PROVIDER: openai | voyage | fake
EMBEDDING_PROVIDER=openai
EMBEDDING_DIM=1536
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
VOYAGE_API_KEY=
VOYAGE_EMBEDDING_MODEL=voyage-3

# retrieval weights (must be tuned; these are the paper's starting point)
RETRIEVAL_W_SIMILARITY=1.0
RETRIEVAL_W_RECENCY=1.0
RETRIEVAL_W_IMPORTANCE=1.0
RECENCY_DECAY=0.995

SIM_CONCURRENCY=12

NEXT_PUBLIC_API_URL=http://localhost:8000
